[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://design_system/components/gamebox_result_panel.gd" id="1_result"]

[node name="GameboxResultPanel" type="PanelContainer"]
visible = false
mouse_filter = 0
theme_type_variation = &"GameboxResultPanelPositive"
script = ExtResource("1_result")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_type_variation = &"GameboxResultContent"

[node name="Meta" type="HBoxContainer" parent="Content"]
layout_mode = 2
theme_type_variation = &"GameboxResultMeta"

[node name="OutcomeChip" type="PanelContainer" parent="Content/Meta"]
