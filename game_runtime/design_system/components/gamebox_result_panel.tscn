theme_type_variation = &"GameboxResultChipPositive"

[node name="Outcome" type="Label" parent="Content/Meta/OutcomeChip"]
layout_mode = 2
text = "胜利"
horizontal_alignment = 1
vertical_alignment = 1
theme_type_variation = &"GameboxResultChipLabelPositive"

[node name="Spacer" type="Control" parent="Content/Meta"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 2

[node name="Confirmed" type="Label" parent="Content/Meta"]
