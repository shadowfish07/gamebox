[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://design_system/components/gamebox_result_panel.gd" id="1_result"]

[node name="GameboxResultPanel" type="PanelContainer"]
visible = false
mouse_filter = 1
theme_type_variation = &"GameboxResultPanel"
script = ExtResource("1_result")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="Result" type="Label" parent="Content"]
layout_mode = 2
horizontal_alignment = 1

[node name="ReturnButton" type="Button" parent="Content"]
custom_minimum_size = Vector2(96, 96)
layout_mode = 2
text = "返回大厅"

[connection signal="pressed" from="Content/ReturnButton" to="." method="_on_return_button_pressed"]
