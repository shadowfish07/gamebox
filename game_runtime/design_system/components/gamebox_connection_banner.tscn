[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://design_system/components/gamebox_connection_banner.gd" id="1_banner"]

[node name="GameboxConnectionBanner" type="PanelContainer"]
visible = false
mouse_filter = 2
theme_type_variation = &"GameboxConnectionBanner"
script = ExtResource("1_banner")

[node name="Content" type="MarginContainer" parent="."]
layout_mode = 2

[node name="Message" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"GameboxOnSecondaryContainer"
text = "正在连接…"
horizontal_alignment = 1
vertical_alignment = 1
autowrap_mode = 2

[node name="AutoHideTimer" type="Timer" parent="."]
one_shot = true

[connection signal="timeout" from="AutoHideTimer" to="." method="_on_auto_hide_timer_timeout"]
